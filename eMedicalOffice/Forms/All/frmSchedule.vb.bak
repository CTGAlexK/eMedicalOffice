    Private PassedTimeScheduleUnloacked As Boolean

    Private Function LockSchedule()
        If (PassedTimeScheduleUnloacked) Then
        Else

        End If
    End Function

    Private Sub cmdScheduleOld_Click(sender As Object, e As EventArgs) Handles cmdScheduleOld.Click
        Dim ApprovedByID As Long
        Dim ApprovedByName As String

        If (PassedTimeScheduleUnloacked) Then
            PassedTimeScheduleUnloacked = False
            cmdScheduleOld.Image = My.Resources.OldTimeOff
        Else
            If gCurrentEmployee.PositionID > 3 Then
                frmSupervisorApproval.LabelMsg.Text = "Unlock Passed time schedule." & vbCrLf & "Function allowed to create schedules to the passed date time"
                If frmSupervisorApproval.ShowDialog <> Windows.Forms.DialogResult.OK Then
                    frmSupervisorApproval.Dispose()
                    Exit Sub
                End If
                ApprovedByID = frmSupervisorApproval.SupervisorID
                ApprovedByName = frmSupervisorApproval.SupervisorName
                frmSupervisorApproval.Dispose()
            Else
                If MsgBox("Please confirm you want to Unlock Passed time schedule." & vbCrLf & "Function allowed to create schedules to the passed date time", MsgBoxStyle.Exclamation + MsgBoxStyle.YesNo) = vbNo Then
                    Exit Sub
                End If
                ApprovedByName = gCurrentEmployee.FName & " " & gCurrentEmployee.LName
            End If
            cmdScheduleOld.Image = My.Resources.OldTimeOn
            PassedTimeScheduleUnloacked = True
        End If
        Timer1_Tick(Nothing, Nothing)
    End Sub

