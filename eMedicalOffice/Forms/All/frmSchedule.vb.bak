    Private ApprovedByID As Integer

    Private Sub ToolStripMenuItemBlock_Click(sender As Object, e As EventArgs) Handles ToolStripMenuItemBlock.Click
        If ActiveSheet.ActiveColumn.Index < 0 Or ActiveSheet.ActiveRow.Index < 0 Then
            Return
        End If
        Dim r As Integer = ActiveSheet.ActiveRow.Index
        Dim c As Integer = ActiveSheet.ActiveColumn.Index
        Dim DiagID As Long = CLng(ActiveSheet.ColumnHeader.Columns(ActiveSheet.ActiveColumn.Index).Tag)
        Dim SchH As Integer = CInt(Val(ActiveSheet.Cells(r, 0).Text))
        Dim SchM As Integer = CInt(Val(ActiveSheet.Cells(r, 1).Text))
        Dim SchAM As String = ActiveSheet.Cells(r, 0).Text.Mid(4, 2)
        Dim DT As DateTime = CDate(DateTimePicker1.Value.Date.ToString("MM/dd/yyyy") & " " & SchH & ":" & SchM & " " & SchAM)
        Dim SI As ScheduleInfo = ActiveSheet.Cells(r, c).Tag
        If ToolStripMenuItemBlock.Text = "Block Spot" Then
            Dim frm As frmScheduleBlockSpot = New frmScheduleBlockSpot()
            frm.calledForm = Me
            frm.DT = DT
            frm.DiagID = DiagID
            frm.LabelDateTime.Text = DT
            frm.AdminLoggedIn = AdminLoggedIn
            If frm.ShowDialog(Me) = DialogResult.OK Then
                AdminLoggedIn = True
                TimerSecurity.Enabled = False
                TimerSecurity.Enabled = True
                SI.SchedulkeBlockID = SchedulkeBlockID
                SI.ToolTip = "" & SchedulkeBlockComment
                SI.ToolTip = SI.ToolTip & vbCrLf & "" & gCurrentEmployee.FName & " " & gCurrentEmployee.LName
                ActiveSheet.Cells(r, c).Tag = SI
                ActiveSheet.Cells(r, c).Locked = True
                ActiveSheet.Cells(r, c).BackColor = Color.Gray
                Dim CT As New FarPoint.Win.Spread.CellType.TextCellType
                CT.BackgroundImage = New FarPoint.Win.Picture(My.Resources.ScheduleLocked)
                CT.BackgroundImage.AlignHorz = FarPoint.Win.HorizontalAlignment.Left
                CT.BackgroundImage.AlignVert = FarPoint.Win.VerticalAlignment.Center
                'CT.BackgroundImage.Style = FarPoint.Win.RenderStyle.Tile
                ActiveSheet.Cells(r, c).CellType = CT
                SchedulkeBlockID = 0
                SchedulkeBlockComment = ""
                ActiveSheet.Cells(r, c).Tag = SI
            End If
        Else
            Dim ApprovedByID As Integer
            If AdminLoggedIn = False Then
                frmSupervisorApproval.LabelMsg.Text = "Unblock the schedule spot: " & vbCrLf & DT & " ?"
                If frmSupervisorApproval.ShowDialog <> Windows.Forms.DialogResult.OK Then
                    frmSupervisorApproval.Dispose()
                    Exit Sub
                End If
                ApprovedByID = frmSupervisorApproval.SupervisorID
                frmSupervisorApproval.Dispose()
            Else
                If MsgBox("Please confirm you want to unblock the schedule spot: " & vbCrLf & DT & " ?", MsgBoxStyle.YesNo + MsgBoxStyle.Exclamation, "Confirm") = MsgBoxResult.No Then
                    Return
                End If
            End If
            If ApprovedByID = 0 Then
                ApprovedByID = gCurrentEmployee.EmpID
            End If
            AdminLoggedIn = True
            TimerSecurity.Enabled = False
            TimerSecurity.Enabled = True
            gSQLUpdateData("UPDATE [ScheduleBlock]  SET Removedby = " & ApprovedByID & ", RemovedByDT = getdate()  WHERE ID = " & SI.SchedulkeBlockID)
            SI.SchedulkeBlockID = 0
            ActiveSheet.Cells(r, c).Locked = False
            ActiveSheet.Cells(r, c).BackColor = Color.White
            Dim CT As New FarPoint.Win.Spread.CellType.TextCellType
            ActiveSheet.Cells(r, c).CellType = CT
            SI.SchedulkeBlockID = 0
            SI.ToolTip = ""
            ActiveSheet.Cells(r, c).Tag = SI
        End If

    End Sub

    Private Sub TimerSecurity_Tick(sender As Object, e As EventArgs) Handles TimerSecurity.Tick
        TimerSecurity.Enabled = False
        AdminLoggedIn = False
        ApprovedByID = 0
    End Sub

    Private Sub TimerReloadSchedule_Tick(sender As Object, e As EventArgs) Handles TimerReloadSchedule.Tick
        TimerReloadSchedule.Enabled = False
        ' Reload Schedule
        DateTimePicker1_ValueChanged(Nothing, Nothing)
    End Sub

