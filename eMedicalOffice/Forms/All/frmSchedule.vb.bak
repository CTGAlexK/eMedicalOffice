    Private Sub PrintPatientsChartToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles PrintPatientsChartToolStripMenuItem.Click
        Print_Chart()
    End Sub

    Private Sub Print_Chart()
        Dim frm As Form = FormsCollection.FindForm("frmPatient")
        Dim PatientID As Long = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID
        Dim CasePrivate = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).CaseTypeID = 3
        Dim ScheduleID = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).ScheduleID
        Dim PatientProcedureID() As String
        Dim I
        Dim Reader As SqlClient.SqlDataReader
        Dim BP As New ArrayList
        Try
            Reader = gSQLGetDataReader("Select PatientProcedureID, BillingProviderID FROM PatientProcedures WHERE ScheduleID = " & ScheduleID)
            If Reader Is Nothing Then Exit Sub
            If Reader.HasRows = False Then Exit Sub
            Do Until Reader.Read = False
                If BP.Contains(Reader("BillingProviderID").ToString()) = False Then
                    BP.Add(Reader("BillingProviderID").ToString())
                    ReDim Preserve PatientProcedureID(I)
                    PatientProcedureID(I) = Reader("PatientProcedureID").ToString()
                    I = I + 1
                End If
            Loop
            If IsArray(PatientProcedureID) = False Then Exit Sub
            Cursor = Cursors.WaitCursor
            frmChart.Button1.Visible = False
            frmChart.Button2.Visible = False
            frmChart.PatientID = PatientID
            frmChart.ChartShouldBePrinted = True
            frmChart.Setup_report(PatientProcedureID, CasePrivate, 0)
            frmChart.MinimizeBox = False
            frmChart.MaximizeBox = False

            frmChart.ShowDialog(Me)
            frmChart.Dispose()

            Cursor = Cursors.Default
        Catch ex As Exception
            TopMost = False
            MsgBox(ex.Message, MsgBoxStyle.Critical, "Error")
            log.Error(ex.Message, ex)
        End Try
    End Sub

    Private Sub mnuScheduledProceduresLabel_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnuScheduledProceduresLabel.Click
        Dim intCounter As Integer
        Dim CR As ReportDocument
        Dim SQL As String
        Dim ConInfo As New TableLogOnInfo
        Dim ScheduleID As Long
        Dim PatientID As Long
        Dim Msg As String = ""
        Dim CL As FarPoint.Win.Spread.Cell = ActiveSheet.ActiveCell
        Dim crParameterDiscreteValue As ParameterDiscreteValue = Nothing
        Dim crParameterFieldDefinitions As ParameterFieldDefinitions = Nothing
        Dim crParameterFieldLocation As ParameterFieldDefinition = Nothing
        Dim crParameterValues As ParameterValues = Nothing
        Dim Reader As SqlClient.SqlDataReader
        Application.DoEvents()
        If CL Is Nothing Then Exit Sub
        If CL.Text = "" Then Exit Sub
        PatientID = CType(CL.Tag, ScheduleInfo).PatientID
        ScheduleID = CType(CL.Tag, ScheduleInfo).ScheduleID

        CR = New rptProceduresLabel
        'Select Case gCDEnvelopeLabelType
        '        Case 1
        '            CR = New rptProceduresFileLabelDK_2205
        '        Case 2
        '            CR = New rptProceduresFileLabelDK_1209
        '        Case Else
        '        CR = New rptProceduresFileLabel
        'End Select

        If SetupCrystalSecurityInfo(CR) = False Then Exit Sub

        SQL = " Select Schedule.ScheduleID "
        SQL &= " FROM Schedule INNER JOIN PatientProcedures ON Schedule.ScheduleID = PatientProcedures.ScheduleID "
        SQL &= " WHERE (PatientProcedures.PatientID = " & PatientID & ") "
        SQL &= " AND (PatientProcedures.ProcedureStatusID<>0 and PatientProcedures.OfficeID = " & gOfficeID & " and ScheduleDateTime > '" & DateTimePicker1.Value.Date & " 00:00" & "' and ScheduleDateTime < '" & DateTimePicker1.Value.Date & " 23:59" & "' )"
        Reader = gSQLGetDataReader(SQL)
        If Reader Is Nothing Then
            MsgBox("System Error. Please call system administrator.", MsgBoxStyle.Critical)
            Exit Sub
        End If
        If Reader.HasRows = False Then
            MsgBox("System Error. Please call system administrator.", MsgBoxStyle.Critical)
            Exit Sub
        End If
        crParameterFieldDefinitions = CR.DataDefinition.ParameterFields

        Do Until Reader.Read = False
            crParameterFieldLocation = crParameterFieldDefinitions.Item("ScheduleID")
            crParameterValues = crParameterFieldLocation.CurrentValues
            crParameterDiscreteValue = New CrystalDecisions.Shared.ParameterDiscreteValue
            crParameterDiscreteValue.Value = Reader("ScheduleID").ToString
            crParameterValues.Add(crParameterDiscreteValue)
        Loop

        crParameterFieldLocation.ApplyCurrentValues(crParameterValues)
        CR.SetParameterValue("PACSPatientIDPadded", Val(gPACSPatientIDPadded))
        'If gPrinterFileLabel <> "" Then CR.PrintOptions.PrinterName = gPrinterFileLabel
        If gPrinterNF3 <> "" Then CR.PrintOptions.PrinterName = gPrinterNF3
        'CR.PrintOptions.PaperSize = PaperSize.DefaultPaperSize
        CR.PrintOptions.ApplyPageMargins(New PageMargins(0, 0, 0, 0))

        CR.PrintToPrinter(1, False, 0, 0)

    End Sub

