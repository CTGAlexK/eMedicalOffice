    Private Sub RemoveShowUpToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles RemoveShowUpToolStripMenuItem.Click
        Dim SI As ScheduleInfo
        Dim sSI As ScheduleInfo
        Dim C As FarPoint.Win.Spread.Cell
        Dim sC As FarPoint.Win.Spread.Cell
        Dim ScheduleID As Long
        Dim SQL As String
        Dim ApprovedByID As Long
        Dim ApprovedByName As String
        Dim Col As Integer
        Dim I As Integer
        If ActiveSheet.ActiveCell.BackColor <> Color.Violet Then
            Exit Sub
        End If
        C = ActiveSheet.ActiveCell
        SI = CType(C.Tag, ScheduleInfo)
        ScheduleID = SI.ScheduleID

        If gCurrentEmployee.PositionID > 3 Then
            frmSupervisorApproval.LabelMsg.Text = "Patient " & C.Text & " left or was set as Present by mistake."
            If frmSupervisorApproval.ShowDialog <> Windows.Forms.DialogResult.OK Then
                frmSupervisorApproval.Dispose()
                Exit Sub
            End If
            ApprovedByID = frmSupervisorApproval.SupervisorID
            ApprovedByName = frmSupervisorApproval.SupervisorName
            frmSupervisorApproval.Dispose()
        Else
            If MsgBox("Patient " & C.Text & " left or was set as Present by mistake." & vbCrLf & vbCrLf & "Please confirm?", MsgBoxStyle.Exclamation + MsgBoxStyle.YesNo) = vbNo Then
                Exit Sub
            End If
            ApprovedByName = gCurrentEmployee.FName & " " & gCurrentEmployee.LName
        End If
        gUpdate_Profile_Log(CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID, PatientLogTypes.tProcedureUndone, "Patient left or was set as Present by mistake", ApprovedByName)
        Dim D As DateTime

        For I = 0 To ActiveSheet.RowCount - 1
            For Col = 2 To ActiveSheet.ColumnCount - 1
                sC = ActiveSheet.Cells(I, Col)
                sSI = CType(sC.Tag, ScheduleInfo)
                If sSI.PatientID = SI.PatientID Then
                    sSI.ShowUpDateTime = "#12:00:00 AM#"
                    sC.Tag = sSI
                    sC.BackColor = Color.Khaki
                    SQL = "Update Schedule set ShowUpDatetime = Null where ScheduleID  = " & sSI.ScheduleID
                    gSQLUpdateData(SQL)
                End If
            Next
        Next
        Calculate_Totals()
        gUpdate_Profile_Log(sSI.PatientID, PatientLogTypes.tScheduleNotPresent, "Patient Left / Not Present: " & Now)
    End Sub

    Private Sub ConfirmedToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles ConfirmedToolStripMenuItem.Click
        Dim SI As ScheduleInfo
        Dim C As FarPoint.Win.Spread.Cell
        Dim ScheduleID As Long
        Dim SQL As String

        C = ActiveSheet.ActiveCell
        SI = CType(C.Tag, ScheduleInfo)
        ScheduleID = SI.ScheduleID
        If gOfficeTypeID = 1 Then
            If MsgBox(ActiveSheet.ActiveCell.Text & vbCrLf & vbCrLf & "Appointment Confirmed?", MsgBoxStyle.Question + MsgBoxStyle.YesNo) = MsgBoxResult.No Then
                Exit Sub
            End If
        Else
            If IsDate(SI.PreCertificationDT) = False Then
                If MsgBox(ActiveSheet.ActiveCell.Text & vbCrLf & vbCrLf & "ATTENTION!" & vbCrLf & vbCrLf & "The Insurance Pre-Sertification has NOT been verified!" & vbCrLf & vbCrLf & "Contact the Insurance company!", MsgBoxStyle.Critical + MsgBoxStyle.YesNo) = MsgBoxResult.No Then
                    Exit Sub
                End If
            Else
                If MsgBox(ActiveSheet.ActiveCell.Text & vbCrLf & vbCrLf & "Appointment Confirmed?", MsgBoxStyle.Question + MsgBoxStyle.YesNo) = MsgBoxResult.No Then
                    Exit Sub
                End If
            End If
        End If
        SI.ConfirmedBy = "Appointment Confirmed at " & FormatDateTime(Now, DateFormat.ShortDate) & " " & FormatDateTime(Now, DateFormat.ShortTime) & " by " & gCurrentEmployee.FName & " " & gCurrentEmployee.LName
        C.Tag = SI
        C.BackColor = Color.BurlyWood
        SQL = "Update Schedule set ConfirmedBy = '" & SI.ConfirmedBy.ToSafeSQLString() & "' where ScheduleID  = " & SI.ScheduleID
        gSQLUpdateData(SQL)
        gUpdate_Profile_Log(SI.PatientID, PatientLogTypes.tScheduleConfirmed, "Schedule: " & SI.ScheduleDateTime & " Confirmed At: " & Now)
        Calculate_Totals()
    End Sub

    Private Sub ToolStripButtonReSchedule_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdReSchedule.Click
        Dim CL As FarPoint.Win.Spread.Cell = ActiveSheet.ActiveCell
        If CL.Column.Index < 2 Then
            Exit Sub
        End If
        If CL Is Nothing Then
            MsgBox("Unable to move schedule." & vbCrLf & "No schedule selected.", MsgBoxStyle.Exclamation)
            Exit Sub
        End If
        If CL.Text = "" Then
            MsgBox("Unable to move schedule." & vbCrLf & "Selected schedule is empty.", MsgBoxStyle.Exclamation)
            Exit Sub
        End If
        If CL.BackColor = Color.MediumAquamarine Then
            MsgBox("Unable to move complete schedule.", MsgBoxStyle.Exclamation)
            Exit Sub
        End If
        Dim NotComplettedProcs As Integer
        NotComplettedProcs = gSQLGetSingleValue("select count(*) from PatientProcedures WHERE ProcedureStatusID<>2 and ProcedureStatusID<>3  AND PatientProcedures.ScheduleID = " & CType(CL.Tag, ScheduleInfo).ScheduleID)
        If NotComplettedProcs = 0 Then
            MsgBox("Unable to move schedule." & vbCrLf & "All procedures in this scheduled appointment are completted.", MsgBoxStyle.Exclamation)
            Exit Sub
        End If
        If Val(FpSpreadDetails_Sheet1.Cells(0, 0).Tag) = 1 Then
            MsgBox("Unable to reschedule this appointments." & vbCrLf & vbCrLf & "No More Appointements!", MsgBoxStyle.Exclamation)
            Exit Sub
        ElseIf Val(FpSpreadDetails_Sheet1.Cells(0, 0).Tag) = 2 Then
            If gCurrentEmployee.PositionID > 3 Then
                frmSupervisorApproval.LabelMsg.Text = "This patient has too many" & vbCrLf & "Cancelations / Reschedules!"
                If frmSupervisorApproval.ShowDialog <> Windows.Forms.DialogResult.OK Then
                    frmSupervisorApproval.Dispose()
                    Exit Sub
                End If
                frmSupervisorApproval.Dispose()
            Else
                If MsgBox("This Patient has too many Cancelations / Reschedules!" & vbCrLf & vbCrLf & "Continue Reschedule?", MsgBoxStyle.Exclamation + MsgBoxStyle.YesNo) = vbNo Then
                    Exit Sub
                End If
            End If

            'MsgBox("Unable to reschedule this appointments." & vbCrLf & vbCrLf & "Too many Cancelations / Reschedules!" & vbCrLf & vbCrLf & "We can continue to service this patient with no schedule only.", MsgBoxStyle.Exclamation)
            'Exit Sub
        End If

        Dim SchH As Integer = CInt(Val(ActiveSheet.Cells(CL.Row.Index, 0).Text))
        Dim SchM As Integer = CInt(Val(ActiveSheet.Cells(CL.Row.Index, 1).Text))
        Dim SchAM As String = ActiveSheet.Cells(CL.Row.Index, 0).Text.Mid(4, 2)
        Dim ScheduleDateTime As Date = CDate(DateTimePicker1.Value.Date.ToString("MM/dd/yyyy") & " " & SchH & ":" & SchM & " " & SchAM)

        frmScheduleMove.Height = Me.Height
        frmScheduleMove.DiagID = CLng(ActiveSheet.ColumnHeader.Columns(ActiveSheet.ActiveColumn.Index).Tag)
        frmScheduleMove.MoveCell = CL
        frmScheduleMove.CurrentSchedule = ScheduleDateTime
        frmScheduleMove.Label1.Text = UCase("ReSchedule Appointment For: " & CL.Text & "  -  Current Schedule: " & ScheduleDateTime)
        frmScheduleMove.Label1.Tag = CL.Text & "  -  Current Schedule: " & ScheduleDateTime
        frmScheduleMove.MinimizeBox = False
        frmScheduleMove.MaximizeBox = False
        frmScheduleMove.PassedTimeScheduleUnloacked = PassedTimeScheduleUnloacked
        frmScheduleMove.ShowDialog(Me)
        frmScheduleMove.Dispose()
        Calculate_Totals()
    End Sub

