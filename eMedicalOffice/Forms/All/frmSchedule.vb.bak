    Private Sub PrintSchedule(ByVal FullSchedule As Boolean)
        Dim Printinfo As New FarPoint.Win.Spread.PrintInfo
        Dim Transportation As String
        Cursor = Cursors.WaitCursor
        Application.DoEvents()
        Dim R As Integer = 0
        Dim C As Integer = 0
        Dim SI As ScheduleInfo
        FpSpreadRpt.ActiveSheet.ColumnCount = 1
        FpSpreadRpt.ActiveSheet.RowCount = 0
        FpSpreadRpt.ActiveSheet.ColumnCount = ActiveSheet.ColumnCount - 1
        For C = 2 To ActiveSheet.ColumnCount - 1
            FpSpreadRpt.ActiveSheet.SetColumnLabel(0, C - 1, ActiveSheet.GetColumnLabel(0, C))
            FpSpreadRpt.ActiveSheet.SetColumnWidth(C - 1, ActiveSheet.GetColumnWidth(C))
        Next
        Dim DataFound As Boolean
        For R = 0 To ActiveSheet.RowCount - 1
            DataFound = False
            For C = 2 To ActiveSheet.ColumnCount - 1
                If ActiveSheet.Cells(R, C).Text <> "" Or FullSchedule = True Then
                    FpSpreadRpt.ActiveSheet.RowCount = FpSpreadRpt.ActiveSheet.RowCount + 1
                    DataFound = True
                    Exit For
                End If
            Next
            If DataFound = False Then
                GoTo NextRow
            End If
            For C = 2 To ActiveSheet.ColumnCount - 1
                Transportation = ""
                If ActiveSheet.Cells(R, C).Text <> "" Or FullSchedule = True Then
                    SI = CType(ActiveSheet.Cells(R, C).Tag, ScheduleInfo)
                    If ActiveSheet.Cells(R, C).Text = "" Then
                        FpSpreadRpt.ActiveSheet.Cells(FpSpreadRpt.ActiveSheet.RowCount - 1, 0).Text =
                            ActiveSheet.Cells(R, 0).Text.ToUpper().Left(ActiveSheet.Cells(R, 0).Text.Length - 3) & ":" & ActiveSheet.Cells(R, 1).Text.ToUpper() & " " & ActiveSheet.Cells(R, 0).Text.Right(2).ToUpper()
                        FpSpreadRpt.ActiveSheet.Cells(FpSpreadRpt.ActiveSheet.RowCount - 1, C - 1).Text = ""
                    Else
                        FpSpreadRpt.ActiveSheet.Cells(FpSpreadRpt.ActiveSheet.RowCount - 1, 0).Text = CDate(SI.ScheduleDateTime).ToString("hh:mm tt")
                        If SI.PickupTransportation = 1 Then
                            Transportation = vbCrLf & "Pickup Home"
                        ElseIf SI.PickupTransportation = 2 Then
                            Transportation = vbCrLf & "Pickup Ref Office"
                        End If
                        If SI.DestinationTransportation = 1 Then
                            Transportation = Transportation & vbCrLf & "DropOff Home"
                        ElseIf SI.PickupTransportation = 2 Then
                            Transportation = Transportation & vbCrLf & "DropOff Ref Office"
                        End If
                        FpSpreadRpt.ActiveSheet.Cells(FpSpreadRpt.ActiveSheet.RowCount - 1, C - 1).Text = ActiveSheet.Cells(R, C).Text & vbCrLf & SI.PatientPhone & Transportation
                    End If
                End If
            Next
NextRow:
        Next
        For C = 0 To FpSpreadRpt.ActiveSheet.ColumnCount - 1
            FpSpreadRpt.ActiveSheet.SetColumnWidth(C, FpSpreadRpt.ActiveSheet.GetPreferredColumnWidth(C) + 20)
        Next
        Application.DoEvents()
        FpSpreadRpt.Refresh()
        Printinfo.SmartPrintPagesWide = 1
        Printinfo.Header = "SCHEDULE FOR THE " & DateTimePicker1.Text.ToUpper & vbCrLf
        Printinfo.BestFitRows = True
        Printinfo.BestFitCols = False
        Printinfo.Preview = True
        Printinfo.ShowShadows = False
        Printinfo.JobName = "eMedical Office Schedule"
        Printinfo.PrintType = FarPoint.Win.Spread.PrintType.All
        Printinfo.ShowColor = True
        Printinfo.ShowColumnHeader = FarPoint.Win.Spread.PrintHeader.Show
        Printinfo.ShowBorder = False
        Printinfo.ShowGrid = True
        Printinfo.ShowPrintDialog = True
        Printinfo.ShowRowHeader = FarPoint.Win.Spread.PrintHeader.Show
        Printinfo.Orientation = FarPoint.Win.Spread.PrintOrientation.Portrait
        Printinfo.SmartPrintRules.Add(New FarPoint.Win.Spread.LandscapeRule(FarPoint.Win.Spread.ResetOption.None))
        Printinfo.SmartPrintRules.Add(New FarPoint.Win.Spread.BestFitColumnRule(FarPoint.Win.Spread.ResetOption.None))
        Printinfo.UseSmartPrint = False
        Printinfo.UseMax = False

        FpSpreadRpt.ActiveSheet.PrintInfo = Printinfo
        FpSpreadRpt.PrintSheet(FpSpreadRpt_Sheet1)
        Cursor = Cursors.Default
    End Sub

    Private Sub ShowUpToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles ShowUpToolStripMenuItem.Click
        Dim SI As ScheduleInfo
        Dim sSI As ScheduleInfo
        Dim C As FarPoint.Win.Spread.Cell
        Dim sC As FarPoint.Win.Spread.Cell
        Dim ScheduleID As Long
        Dim SQL As String
        Dim I As Integer
        Dim Col As Integer
        Dim PaidAmount As Decimal = 0
        Dim BilledAmount As Decimal = 0
        C = ActiveSheet.ActiveCell
        SI = CType(C.Tag, ScheduleInfo)
        ScheduleID = SI.ScheduleID
        BilledAmount = gSQLGetSingleValue("SELECT     BillAmount FROM Bills WHERE Bills.ScheduleID = " & ScheduleID)
        PaidAmount = gSQLGetSingleValue("SELECT     sum(BillPayments.PaymentAmount) as PaidAmount FROM Bills INNER JOIN BillPayments ON Bills.BillID = BillPayments.BillID WHERE Bills.ScheduleID = " & ScheduleID)

        If SI.CaseTypeID = 4 And (BilledAmount = 0 Or (PaidAmount < BilledAmount)) Then

            frmCashPayment.ScheduleID = ScheduleID
            frmCashPayment.MinimizeBox = False
            frmCashPayment.MaximizeBox = False

            If frmCashPayment.ShowDialog(Me) <> Windows.Forms.DialogResult.OK Then
                MsgBox("Procedure can not be accomplished." & vbCrLf & "Payment Required." & vbCrLf & vbCrLf & vbCrLf & "If payment amount not been collected, please cancel this appointment.", MsgBoxStyle.Exclamation)
                Exit Sub
            End If
            SI.ProcedurePaid = 1
            SI.ShowUpDateTime = Now
            C.Tag = SI
            C.BackColor = Color.Violet
            SQL = "Update Schedule set ShowUpDatetime = getdate() where ScheduleID  = " & SI.ScheduleID
            gSQLUpdateData(SQL)
        Else
            If MsgBox("Please confirm the patient " & C.Text & " is waiting...", MsgBoxStyle.Question + MsgBoxStyle.YesNo) = MsgBoxResult.No Then
                Exit Sub
            End If
        End If

        For I = 0 To ActiveSheet.RowCount - 1
            For Col = 2 To ActiveSheet.ColumnCount - 1
                sC = ActiveSheet.Cells(I, Col)
                sSI = CType(sC.Tag, ScheduleInfo)
                If sSI.PatientID = SI.PatientID Then
                    sSI.ShowUpDateTime = Now
                    sC.Tag = sSI
                    sC.BackColor = Color.Violet
                    SQL = "Update Schedule set ShowUpDatetime = getdate() where ScheduleID  = " & sSI.ScheduleID
                    gSQLUpdateData(SQL)
                End If
            Next
        Next
        mnuScheduledProceduresLabel_Click(Nothing, Nothing)
        'Print_Chart()
        Calculate_Totals()
        gUpdate_Profile_Log(SI.PatientID, PatientLogTypes.tSchedulePresent, "Schedule: " & SI.ScheduleDateTime & " Patient Present: " & Now)
    End Sub

    Public Sub ToolStripButtonRefresh_Click(ByVal sender As Object, ByVal e As EventArgs) Handles ToolStripButton1.Click
        Dim C As FarPoint.Win.Spread.Cell
        Cursor = Cursors.WaitCursor
        Application.DoEvents()
        LockWindowUpdate(Me.Handle)
        C = ActiveSheet.ActiveCell
        Application.DoEvents()
        Load_Schedule()

        Timer1_Tick(Nothing, Nothing)
        If Not C Is Nothing Then
            ActiveSheet.SetActiveCell(C.Row.Index, C.Column.Index)
        End If
        LockWindowUpdate(0)
        Cursor = Cursors.Default
    End Sub

