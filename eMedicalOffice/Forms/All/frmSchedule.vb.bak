    Private Sub TransportationToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles TransportationToolStripMenuItem.Click
        Dim CT As New FarPoint.Win.Spread.CellType.TextCellType
        Dim SI As ScheduleInfo
        frmRequireTransportation.CalledForm = Me
        frmRequireTransportation.ComboBoxPickup.SelectedIndex = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PickupTransportation
        If frmRequireTransportation.ComboBoxPickup.SelectedIndex = 3 Then
            frmRequireTransportation.txtPickupOther.Text = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PickupTransportationOther
        Else
            frmRequireTransportation.txtPickupOther.Text = ""
        End If
        frmRequireTransportation.ComboBoxDestination.SelectedIndex = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).DestinationTransportation
        If frmRequireTransportation.ComboBoxDestination.SelectedIndex = 3 Then
            frmRequireTransportation.txtDestinationOther.Text = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).DestinationTransportationOther
        Else
            frmRequireTransportation.txtDestinationOther.Text = ""
        End If

        If frmRequireTransportation.ShowDialog() <> Windows.Forms.DialogResult.OK Then
            frmRequireTransportation.Dispose()
            Exit Sub
        End If
        frmRequireTransportation.Dispose()
        If ReturnSchPickupTransportation > 0 Or ReturnSchDestinationTransportation > 0 Then
            SI = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo)
            SI.PickupTransportation = ReturnSchPickupTransportation
            If ReturnSchPickupTransportation = 3 Then
                SI.PickupTransportationOther = ReturnSchPickupTransportationOther
            Else
                SI.PickupTransportationOther = ""
            End If

            SI.DestinationTransportation = ReturnSchDestinationTransportation
            If ReturnSchDestinationTransportation = 3 Then
                SI.DestinationTransportationOther = ReturnSchDestinationTransportationOther
            Else
                SI.DestinationTransportationOther = ""
            End If

            CT.BackgroundImage = New FarPoint.Win.Picture(PictureBoxTransportation.Image)
            CT.BackgroundImage.AlignHorz = FarPoint.Win.HorizontalAlignment.Right
            CT.BackgroundImage.AlignVert = FarPoint.Win.VerticalAlignment.Center
            ActiveSheet.ActiveCell.CellType = CT
            ActiveSheet.ActiveCell.Tag = SI
            gSQLUpdateData("UPDATE Schedule set UpdatedByEmpID=" & gCurrentEmployee.EmpID.ToString & ", UpdatedDT=getdate(), PickupTransportation=" & ReturnSchPickupTransportation & ", DestinationTransportation=" & ReturnSchDestinationTransportation & ", PickupTransportationOther='" & ReturnSchPickupTransportationOther.ToSafeSQLString() & "', DestinationTransportationOther='" & ReturnSchDestinationTransportationOther.ToSafeSQLString() & "' Where  ScheduleID=" & CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).ScheduleID)
            gUpdate_Profile_Log(CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID, PatientLogTypes.tTransportationCanceled)
        Else
            SI = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo)
            SI.PickupTransportation = ReturnSchPickupTransportation
            If SI.PickupTransportation = 3 Then
                SI.PickupTransportationOther = ReturnSchPickupTransportationOther
            End If

            SI.DestinationTransportation = ReturnSchDestinationTransportation
            If SI.DestinationTransportation = 3 Then
                SI.DestinationTransportationOther = ReturnSchDestinationTransportationOther
            End If

            ActiveSheet.ActiveCell.CellType = CT
            ActiveSheet.ActiveCell.Tag = SI
            gSQLUpdateData("UPDATE Schedule set UpdatedByEmpID=" & gCurrentEmployee.EmpID.ToString & ", UpdatedDT=getdate(), PickupTransportation=" & ReturnSchPickupTransportation & ", DestinationTransportation='" & ReturnSchDestinationTransportation & "', PickupTransportationOther='" & ReturnSchPickupTransportationOther.ToSafeSQLString() & "', DestinationTransportationOther='" & ReturnSchDestinationTransportationOther & "' Where ScheduleID=" & CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).ScheduleID)
            gUpdate_Profile_Log(CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID, PatientLogTypes.tTransportationRequested)
        End If
        gUpdate_Profile_Log(CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID, PatientLogTypes.tScheduleTransportationChanged, "Transportation Requirements Changed")
    End Sub

    Private Sub SetAsUnDoneToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles SetAsUnDoneToolStripMenuItem.Click
        Dim PatientID As Long
        Dim ApprovedByID As Long
        Dim ApprovedByName As String
        If gCurrentEmployee.PositionID > 3 Then
            frmSupervisorApproval.LabelMsg.Text = "Undone Procedure."
            If frmSupervisorApproval.ShowDialog <> Windows.Forms.DialogResult.OK Then
                frmSupervisorApproval.Dispose()
                Exit Sub
            End If
            ApprovedByID = frmSupervisorApproval.SupervisorID
            ApprovedByName = frmSupervisorApproval.SupervisorName
            frmSupervisorApproval.Dispose()
        Else
            If MsgBox("Undone Procedure." & vbCrLf & vbCrLf & "Please confirm?", MsgBoxStyle.Exclamation + MsgBoxStyle.YesNo) = vbNo Then
                Exit Sub
            End If
            ApprovedByName = gCurrentEmployee.FName & " " & gCurrentEmployee.LName
        End If
        gUpdate_Profile_Log(CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID, PatientLogTypes.tScheduleNotCompleted, "Procedure marked done by mistake", ApprovedByName)

        If ActiveSheet.ActiveCell.Text <> "" Then
            FpSpreadSchedule.EditMode = False
            frmScheduleUndone.Load_Procedures(CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).ScheduleID)
            PatientID = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID
            Dim SaveRow As Integer = ActiveSheet.ActiveRowIndex
            Dim SaveCol As Integer = ActiveSheet.ActiveColumnIndex
            frmScheduleUndone.MinimizeBox = False
            frmScheduleUndone.MaximizeBox = False
            If frmScheduleUndone.ShowDialog(Me) = Windows.Forms.DialogResult.OK Then
                Load_Schedule()
                Timer1_Tick(Nothing, Nothing)
                ActiveSheet.SetActiveCell(SaveRow, SaveCol)
                LockWindowUpdate(Panel3.Handle)
                Show_Details(PatientID)
                LockWindowUpdate(0)
            End If
            frmScheduleUndone.Dispose()
            Calculate_Totals()
        End If
    End Sub

    Private Sub ShowPatientsInformationToolStripMenuItem_Click(ByVal sender As Object, ByVal e As EventArgs) Handles ShowPatientsInformationToolStripMenuItem.Click

        Try
            Using NewFrm As New frmPatient
                Dim PatientID As Integer = CType(ActiveSheet.ActiveCell.Tag, ScheduleInfo).PatientID
                NewFrm.InitialTab = 0
                NewFrm.InitialPatientName = PatientID
                NewFrm.Width = 1225
                NewFrm.WindowState = FormWindowState.Normal
                NewFrm.Location = New Point(Me.Left + ((Width - frmPatient.Size.Width) \ 2), Me.Top + ((Height - frmPatient.Size.Height) \ 2))
                NewFrm.MinimizeBox = False
                NewFrm.MaximizeBox = False
                NewFrm.ShowDialog(Me)
            End Using
        Catch ex As Exception
            log.Error(ex)
        End Try
        Cursor = Cursors.Default

    End Sub

