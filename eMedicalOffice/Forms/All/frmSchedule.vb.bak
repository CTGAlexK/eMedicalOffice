    Private Sub TimerResizeRows_Tick(ByVal sender As Object, ByVal e As EventArgs) Handles TimerResizeRows.Tick
        TimerResizeRows.Enabled = False
        Resize_Rows()
    End Sub

    Private Sub Resize_Rows()
        Dim SpreadHeight As Double
        Dim RowHeight As Double
        Dim i As Integer
        SpreadHeight = FpSpreadSchedule.Height - ActiveSheet.ColumnHeader.Rows(0).Height
        RowHeight = ActiveSheet.Rows(0).Height + 1
        If SpreadHeight > RowHeight * ActiveSheet.RowCount Then
            If (SpreadHeight / ActiveSheet.RowCount) - 1 > 20 Then
                FpSpreadSchedule.SuspendLayout()
                For i = 0 To ActiveSheet.RowCount - 1
                    ActiveSheet.Rows(i).Height = (SpreadHeight / ActiveSheet.RowCount) - 1
                Next
                FpSpreadSchedule.ResumeLayout()
            End If
        End If
    End Sub

