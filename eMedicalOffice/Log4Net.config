<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <log4net>
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="logger.log" />
      <staticLogFileName value="true" />
      <appendToFile value="true" />
      <maximumFileSize value="100KB" />
      <maxSizeRollBackups value="2" />
      <param name="LockingModel" type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %logger %exception %message %exception %newline%newline" />
      </layout>
    </appender>
    
    <root>

      <!--
          Tag <level value="........." /> specifies t he Application log level and may have one of the following values:
					ALL 
					DEBUG 
					INFO 
					WARN 
					ERROR 
					FATAL 
					OFF 
          
          The Log4net will process records for the Levels followed from the heigh to low.
          For Ex: if the ERROR level specified, the ERROR and FATAL log levels will be logged.
				-->
      <level value="ALL" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
</configuration>